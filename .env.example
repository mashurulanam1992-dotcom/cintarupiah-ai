# Salin file ini menjadi .dev.vars untuk pengembangan lokal (npx wrangler pages dev .)
# Di Cloudflare Pages, isi nilai-nilai ini lewat Settings > Variables and Secrets.
# JANGAN pernah menaruh nilai asli di file ini atau di repository.

# WAJIB (simpan sebagai secret). Dibuat di Google AI Studio.
GEMINI_API_KEY=

# Opsional: nama model Gemini utama dan cadangan
GEMINI_MODEL=
GEMINI_MODEL_CADANGAN=

# Opsional: model Workers AI untuk chatbot (bila binding AI aktif)
WORKERS_AI_MODEL=

# Opsional: batas permintaan per pengunjung per jam
BATAS_CHAT_PER_JAM=
BATAS_SCAN_PER_JAM=
BATAS_RINGKAS_PER_JAM=
BATAS_LATIHAN_PER_JAM=

# Binding (diatur di dashboard Cloudflare, bukan di file ini):
#   AI    -> Workers AI (opsional)
#   CACHE -> KV namespace (opsional, agar cache dan pembatas berlaku global)
